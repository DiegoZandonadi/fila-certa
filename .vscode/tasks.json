{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: agente Python",
      "type": "shell",
      "command": "$python = Join-Path $env:LOCALAPPDATA 'Programs\\Python\\Python312\\python.exe'; if (!(Test-Path -LiteralPath $python)) { $python = (Get-Command python -ErrorAction Stop).Source }; & $python -m venv .venv; .\\.venv\\Scripts\\python.exe -m pip install -e \".[dev]\"",
      "options": {
        "cwd": "${workspaceFolder}/support-agent"
      },
      "problemMatcher": []
    },
    {
      "label": "run: agente Python",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn support_agent.main:app --reload --port 6969",
      "options": {
        "cwd": "${workspaceFolder}/support-agent"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "run: backend Java",
      "type": "shell",
      "command": ".\\mvnw.cmd -DskipTests package; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; java -jar .\\target\\fila-certa-1.0.0.jar",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "test: tudo",
      "type": "shell",
      "command": ".\\mvnw.cmd test; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; .\\support-agent\\.venv\\Scripts\\python.exe -m pytest .\\support-agent\\tests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
